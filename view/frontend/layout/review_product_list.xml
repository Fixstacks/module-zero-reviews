<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The review list renders it for each review (Magento_Review::product/view/list.phtml). -->
        <referenceBlock name="product_review_list">
            <block name="zero.reviews.extras" template="Zero_Reviews::list/extras.phtml">
                <arguments>
                    <argument name="extras" xsi:type="object">Zero\Reviews\ViewModel\Extras</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
