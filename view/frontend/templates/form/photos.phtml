<div class="field review-field-photos">
    <label for="review_photos" class="label"><span><?= $escaper->escapeHtml(__('Photos')) ?></span></label>
    <div class="control">
        <input type="file" name="photos[]" id="review_photos" multiple
               accept="image/jpeg,image/png,image/webp" class="file-input file-input-bordered file-input-sm w-full max-w-md"
               aria-describedby="review_photos_note">
        <p id="review_photos_note" class="text-label text-base-content/60 mt-1">
            <?= $escaper->escapeHtml(__('Up to %1 photos, JPEG, PNG or WebP, %2 MB each. Shown with your review once it is approved.', $extras->maxPhotos(), $extras->maxMegabytes())) ?>
        </p>
    </div>
</div>
